<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>io.orion</groupId>
  <artifactId>orion-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Orion Intelligence Platform</name>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>orion-shared-kernel</module>
    <module>orion-identity</module>
    <module>orion-audit</module>
    <module>orion-ontology</module>
    <module>orion-graph</module>
    <module>orion-app</module>
    <module>orion-knowledge</module>
    <module>orion-ingestion</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.orion</groupId>
        <artifactId>orion-shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.orion</groupId>
        <artifactId>orion-identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.orion</groupId>
        <artifactId>orion-audit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.orion</groupId>
        <artifactId>orion-ontology</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.orion</groupId>
        <artifactId>orion-knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
